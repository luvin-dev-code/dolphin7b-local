<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvDeleteDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_session_dialog_title"
        android:textColor="#F5F3FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDeleteDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/delete_session_dialog_message"
        android:textColor="#D8B4FE"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelDelete"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_chip_preset"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/delete_session_btn_cancel"
            android:textColor="#E9D5FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnConfirmDelete"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_danger_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="116dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/delete_session_btn_confirm"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
